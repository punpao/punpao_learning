# ═══════════════════════════════════════════════════════════════════════════════
#  data-engineering-lab — environment template
#
#  1. cp .env.example .env            (or: make init)
#  2. replace every <FILL_ME>          (RUNBOOK.md §2 lists every key; §3 says how to get it)
#     make secrets                     prints strong random values for every secret below
#  3. make up
#
#  Rules: one KEY=value per line, no quotes, no spaces around "=", no inline comments.
#  Passwords and keys: use only letters, digits, "-" and "_" (they end up inside URLs).
#  .env is git-ignored. Never commit it.
#  Keys with a default (ports, bucket names) are safe local values; change if they clash.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Source Postgres (profile: core) — the OLTP database labs write to; CDC source ───
# Host port for the source DB (localhost only); change if 5433 is taken
SOURCE_PG_HOST_PORT=5433
# Database name created on first start
SOURCE_PG_DB=labdb
# Owner/superuser of the source DB — pick a username, e.g. lab_admin
SOURCE_PG_USER=<FILL_ME>
# Password for SOURCE_PG_USER — 16+ chars, letters/digits/-/_ only
SOURCE_PG_PASSWORD=<FILL_ME>
# Least-privilege login Debezium uses (REPLICATION + SELECT only) — e.g. debezium
SOURCE_PG_CDC_USER=<FILL_ME>
# Password for SOURCE_PG_CDC_USER — 16+ chars, letters/digits/-/_ only
SOURCE_PG_CDC_PASSWORD=<FILL_ME>
# Publication created on first start; Debezium connectors subscribe to it
DEBEZIUM_PUBLICATION=dbz_publication

# ─── Platform DB (profile: core) — metadata for Airflow and Lakekeeper, not lab data ───
# Host port for the platform DB (localhost only)
PLATFORM_DB_HOST_PORT=5434
# Superuser of the platform DB — pick a username, e.g. platform_admin
PLATFORM_DB_SUPERUSER=<FILL_ME>
# Password for PLATFORM_DB_SUPERUSER — 16+ chars, letters/digits/-/_ only
PLATFORM_DB_SUPERUSER_PASSWORD=<FILL_ME>
# Password for the "airflow" role that owns the Airflow metadata DB
AIRFLOW_DB_PASSWORD=<FILL_ME>
# Password for the "lakekeeper" role that owns the Iceberg catalog DB
LAKEKEEPER_DB_PASSWORD=<FILL_ME>

# ─── MinIO object storage (profile: core) ───
# Host port for the S3 API (localhost only)
MINIO_API_HOST_PORT=9000
# Host port for the MinIO web console (localhost only)
MINIO_CONSOLE_HOST_PORT=9001
# MinIO root (admin) username — 3+ chars, e.g. minio_admin; only used for admin tasks
MINIO_ROOT_USER=<FILL_ME>
# MinIO root password — 8+ chars (use 24+), letters/digits/-/_ only
MINIO_ROOT_PASSWORD=<FILL_ME>
# S3 access key of the least-privilege lab user (created by minio-init) — 3–20 chars
LAKEHOUSE_S3_ACCESS_KEY=<FILL_ME>
# S3 secret key of the lab user — 8–40 chars, letters/digits/-/_ only
LAKEHOUSE_S3_SECRET_KEY=<FILL_ME>
# Bucket holding the Iceberg warehouse
LAKEHOUSE_BUCKET=lakehouse
# Bucket for raw/landing files
RAW_BUCKET=raw
# Region string S3 clients send; MinIO accepts any value, keep the default
S3_REGION=us-east-1

# ─── Lakekeeper Iceberg REST catalog (profile: core) ───
# Host port for the catalog API and UI (localhost only)
LAKEKEEPER_HOST_PORT=8181
# Key Lakekeeper uses to encrypt stored S3 credentials — 32+ random chars; never change after first start
LAKEKEEPER_ENCRYPTION_KEY=<FILL_ME>
# Name of the Iceberg warehouse registered on first start
LAKEKEEPER_WAREHOUSE=lakehouse

# ─── Kafka / Kafka Connect / Kafka UI (profile: streaming) ───
# Host port for Kafka clients on your laptop (bootstrap: localhost:9092)
KAFKA_HOST_PORT=9092
# KRaft cluster id (22-char base64 UUID); the default is fine for a single local cluster
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
# Host port for the Kafka Connect REST API
KAFKA_CONNECT_HOST_PORT=8083
# Host port for Kafka UI
KAFKA_UI_HOST_PORT=8082
# Kafka UI login username — e.g. admin
KAFKA_UI_USER=<FILL_ME>
# Kafka UI login password — 12+ chars
KAFKA_UI_PASSWORD=<FILL_ME>
# Debezium replication slot name used by the connector template
DEBEZIUM_SLOT_NAME=debezium_lab
# Prefix for CDC topic names (<prefix>.<schema>.<table>)
CDC_TOPIC_PREFIX=cdc

# ─── Airflow 3 (profile: orchestration) ───
# Host port for the Airflow UI/API
AIRFLOW_HOST_PORT=8080
# UID the Airflow containers run as. macOS/Windows: keep 50000. Linux: output of `id -u`
AIRFLOW_UID=50000
# Airflow admin username for the UI — e.g. admin
AIRFLOW_ADMIN_USER=<FILL_ME>
# Airflow admin password — 12+ chars
AIRFLOW_ADMIN_PASSWORD=<FILL_ME>
# Fernet key that encrypts connections/variables in the metadata DB — generate, see RUNBOOK §3.2
AIRFLOW_FERNET_KEY=<FILL_ME>
# [api] secret_key (Airflow 3's replacement for the webserver secret key) — generate, see RUNBOOK §3.2
AIRFLOW_API_SECRET_KEY=<FILL_ME>
# [api_auth] jwt_secret shared by all Airflow components — generate, see RUNBOOK §3.2
AIRFLOW_JWT_SECRET=<FILL_ME>

# ─── Snowflake (optional — leave as <FILL_ME> to skip; only the `snowflake` dbt target uses these) ───
# Account identifier, format <orgname>-<accountname> (RUNBOOK §3.3)
SNOWFLAKE_ACCOUNT=<FILL_ME>
# Service user dbt logs in as — e.g. DE_LAB_DBT
SNOWFLAKE_USER=<FILL_ME>
# Role dbt uses — e.g. DE_LAB_ROLE
SNOWFLAKE_ROLE=<FILL_ME>
# Virtual warehouse dbt runs on — e.g. DE_LAB_WH
SNOWFLAKE_WAREHOUSE=<FILL_ME>
# Database dbt builds into — e.g. DE_LAB
SNOWFLAKE_DATABASE=<FILL_ME>
# Default schema for dbt models — e.g. DBT_DEV
SNOWFLAKE_SCHEMA=<FILL_ME>
# File name of the encrypted private key inside ./secrets/
SNOWFLAKE_PRIVATE_KEY_FILE=snowflake_rsa_key.p8
# Passphrase you chose when creating the private key
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<FILL_ME>
