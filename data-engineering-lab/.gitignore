data/*
!data/README.md
*.duckdb
*.duckdb.wal
docker/kafka-connect/plugins/*
!docker/kafka-connect/plugins/README.md

# ── Python / uv ──
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# ── dbt ──
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

